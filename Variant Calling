###Create the conda enviornment (could no include freebayes in this enviornment due to a dependency conflict on the HPC)
conda create -n main_env -c bioconda -c conda-forge bwa fastqc samtools bcftools 
conda activate main_env

###Quality control of the reads
mkdir quality
fastqc --outdir quality --noextract --nogroup --format fastq --threads 2 --quiet ../mutant_GeneX_R1.fastq
fastqc --outdir quality --noextract --nogroup --format fastq --threads 2 --quiet ../mutant_GeneX_R2.fastq
fastqc --outdir quality --noextract --nogroup --format fastq --threads 2 --quiet ../normal_GeneX_R1.fastq
fastqc --outdir quality --noextract --nogroup --format fastq --threads 2 --quiet ../normal_GeneX_R2.fastq

###index the gene X reference genome
bwa index ../GeneX_reference.fa 

###Map the reads to the gene X reference genome
bwa mem -t 2 -R '@RG\tID:mutant\tSM:mutant\tPL:ILLUMINA\tLB:WGS\tPU:HiSeq2500' \
  ../GeneX_reference.fa \
  ../mutant_GeneX_R1.fastq \
  ../mutant_GeneX_R2.fastq | \
  samtools view -b -@ 2 | \
  samtools sort -@ 2 -o mutant_sorted.bam -

bwa mem -t 2 -R '@RG\tID:normal\tSM:normal\tPL:ILLUMINA\tLB:WGS\tPU:HiSeq2500' \
  ../GeneX_reference.fa \
  ../normal_GeneX_R1.fastq \
  ../normal_GeneX_R2.fastq | \
  samtools view -b -@ 2 | \
  samtools sort -@ 2 -o normal_sorted.bam -

###checked the quality of the read mapping
samtools flagstat mutant_sorted.bam
samtools flagstat normal_sorted.bam

### index the BAM files for IGV
samtools index -@ 2 mutant_sorted.bam
samtools index -@ 2 normal_sorted.bam

###create a freebayes environment 
conda create -n freebayes_env -c bioconda -c conda-forge freebayes
conda activate freebayes_env

### variant calling 
freebayes --ploidy 1 --min-mapping-quality 30 --min-base-quality 25 --fasta-reference ../GeneX_reference.fa mutant_sorted.bam > mutant_ploidy1.vcf
freebayes --ploidy 1 --min-mapping-quality 30 --min-base-quality 25 --fasta-reference ../GeneX_reference.fa normal_sorted.bam > normal_ploidy1.vcf
conda deactivate
conda activate main_env

### filter for high quality variants
bcftools view -e 'QUAL < 10 || INFO/DP < 10 || AF = 0' -O v -o mutant_ploidy1_filtered.vcf mutant_ploidy1.vcf

###compress the vcf 
bgzip mutant_ploidy1_filtered.vcf
bgzip normal_ploidy1_filtered.vcf

###index the vcf
bcftools index mutant_ploidy1_filtered.vcf.gz
bcftools index normal_ploidy1_filtered.vcf.gz

###create a consensus sequence
bcftools consensus -s mutant -f ../GeneX_reference.fa -o GeneX_mutant_consensus.fna mutant_ploidy1_filtered.vcf.gz 
bcftools consensus -s normal -f ../GeneX_reference.fa -o GeneX_normal_consensus.fna normal_ploidy1_filtered.vcf.gz 

####rename
sed -i 's/>GeneX_reference/>GeneX_mutant/' GeneX_mutant_consensus.fna
sed -i 's/>GeneX_reference/>GeneX_normal/' GeneX_normal_consensus.fna




  
